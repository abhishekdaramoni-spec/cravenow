// CraveNow Environment Configuration
// Copy this file to .env and fill in your values.

// ============================================
// SUPABASE (Required for production)
// ============================================
// Get these from: https://app.supabase.com → Project Settings → API
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-key"

// ============================================
// DEMO MODE
// ============================================
// Set to "true" to run with mock data when Supabase is not configured.
// The app auto-detects this if VITE_SUPABASE_URL is not set.
VITE_DEMO_MODE="true"

// ============================================
// RAZORPAY (Optional - for payments)
// ============================================
// Get test keys from: https://dashboard.razorpay.com → Settings → API Keys
VITE_RAZORPAY_KEY_ID="rzp_test_xxxxxxxxxxxxx"
// NEVER put RAZORPAY_KEY_SECRET in frontend code!

// ============================================
// GOOGLE GEMINI AI (Optional - for AI features)
// ============================================
// Get from: https://aistudio.google.com/apikey
// WARNING: This should be used via a server-side proxy, NOT in client code.
// GEMINI_API_KEY="your-gemini-api-key"

// ============================================
// GOOGLE MAPS (Optional - for map features)
// ============================================
VITE_GOOGLE_MAPS_KEY="your-google-maps-key"
